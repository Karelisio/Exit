    <string name="perm_notifications_title">Notifications</string>
    <string name="perm_notifications_why">Pour te prévenir quand la prochaine cigarette est « autorisée » et fêter chaque jalon santé.</string>
    <string name="perm_notifications_detail">Aucune publicité, aucun rappel culpabilisant : seulement l\'essentiel, au bon moment.</string>
    <string name="perm_exact_alarms_title">Alarmes exactes</string>
    <string name="perm_exact_alarms_why">Pour que la notification « c\'est OK » arrive à la minute près, pas un quart d\'heure plus tard.</string>
    <string name="perm_exact_alarms_detail">Android limite les alarmes précises : Exit en programme au plus une à la fois.</string>
    <string name="perm_battery_title">Batterie sans restriction</string>
    <string name="perm_battery_why">Ton téléphone peut mettre Exit en veille forcée et faire sauter les rappels.</string>
    <string name="perm_battery_detail">Sur Honor (MagicOS), autorise aussi Exit dans « Lancement d\'applis » → Gérer manuellement.</string>
    <string name="perm_install_title">Mises à jour</string>
    <string name="perm_install_why">Pour installer les nouvelles versions d\'Exit directement depuis l\'appli.</string>
    <string name="perm_install_detail">Exit n\'est pas sur le Play Store : les mises à jour viennent des releases GitHub, signées avec la même clé.</string>
