<resources>
    <string name="source_tis">Tabac info service</string>
    <string name="source_oms">OMS</string>
    <string name="milestone_0_label">20 min</string>
    <string name="milestone_0_title">Cœur apaisé</string>
    <string name="milestone_0_text">La pression sanguine et les pulsations du cœur redeviennent normales.</string>
    <string name="milestone_1_label">8 h</string>
    <string name="milestone_1_title">Oxygène retrouvé</string>
    <string name="milestone_1_text">La quantité de monoxyde de carbone dans le sang diminue de moitié. L\'oxygénation des cellules redevient normale.</string>
    <string name="milestone_2_label">24 h</string>
    <string name="milestone_2_title">Zéro nicotine</string>
    <string name="milestone_2_text">Le risque d\'infarctus diminue déjà. Les poumons commencent à éliminer le mucus et les résidus de fumée. Le corps ne contient plus de nicotine.</string>
    <string name="milestone_3_label">48 h</string>
    <string name="milestone_3_title">Goût et odorat</string>
    <string name="milestone_3_text">Le goût et l\'odorat s\'améliorent. Les terminaisons nerveuses gustatives commencent à repousser.</string>
    <string name="milestone_4_label">72 h</string>
    <string name="milestone_4_title">Respirer mieux</string>
    <string name="milestone_4_text">Respirer devient plus facile. Les bronches commencent à se relâcher et on se sent plus énergique.</string>
    <string name="milestone_5_label">2 semaines</string>
    <string name="milestone_5_title">Circulation</string>
    <string name="milestone_5_text">La circulation sanguine s\'améliore et la fonction pulmonaire augmente (2 semaines à 3 mois).</string>
    <string name="milestone_6_label">1 mois</string>
    <string name="milestone_6_title">Moins de toux</string>
    <string name="milestone_6_text">La toux et la fatigue diminuent. On récupère du souffle et on marche plus facilement.</string>
    <string name="milestone_7_label">3 mois</string>
    <string name="milestone_7_title">Poumons plus forts</string>
    <string name="milestone_7_text">La fonction pulmonaire s\'améliore nettement. Les cils bronchiques repoussent et l\'essoufflement diminue (1 à 9 mois).</string>
    <string name="milestone_8_label">1 an</string>
    <string name="milestone_8_title">Cœur protégé</string>
    <string name="milestone_8_text">Le risque de maladie coronarienne est réduit de moitié par rapport à celui d\'un fumeur.</string>
    <string name="milestone_9_label">5 ans</string>
    <string name="milestone_9_title">AVC</string>
    <string name="milestone_9_text">Le risque d\'accident vasculaire cérébral rejoint celui d\'un non-fumeur (5 à 15 ans). Le risque de cancer de la bouche, de la gorge et de l\'œsophage est divisé par deux.</string>
    <string name="milestone_10_label">10 ans</string>
    <string name="milestone_10_title">Cancer du poumon</string>
    <string name="milestone_10_text">Le risque de cancer du poumon est environ moitié moindre que celui d\'un fumeur.</string>
    <string name="milestone_11_label">15 ans</string>
    <string name="milestone_11_title">Comme un non-fumeur</string>
    <string name="milestone_11_text">Le risque de maladie coronarienne est celui d\'un non-fumeur.</string>
